<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Payment Verification OTP SMS Simulation</title>
    <style>
        {{CSS_CONTENT}}
    </style>
</head>
<body>
    <div class="phone-wrapper">
        <div class="phone-header">
            <div class="status-bar">
                <span>{{CURRENT_TIME_SHORT}}</span>
                <span>📶 🔋</span>
            </div>
            <div class="sender-info">
                <div class="sender-avatar">🏛️</div>
                <div class="sender-name">CAMPUS-PAY</div>
                <div class="sender-sub">Campus Payment Gateway</div>
            </div>
        </div>

        <div class="message-container">
            <div class="time-divider">Today {{CURRENT_TIME_SHORT}}</div>

            <div class="sms-bubble">
                <div class="bubble-header">
                    <span class="lock-icon">🔒</span>
                    <span class="header-text">Payment Authorization OTP</span>
                </div>

                <div class="bubble-body">
                    <p class="greeting">Dear {{FULL_NAME}},</p>
                    <p class="message-text">
                        Use OTP <strong class="otp-code">{{TOKEN_CODE}}</strong> to authorize your payment of <strong class="amount-highlight">LKR {{AMOUNT}}</strong> for <em>Campus Services Tuition / Fee Settlement</em> (Ref: <code>{{TRANSACTION_ID}}</code>).
                    </p>

                    <div class="security-warning">
                        ⚠️ Do NOT share this OTP with anyone. {{EXPIRES_AT_STR}}. If you did not initiate this transaction of LKR {{AMOUNT}}, contact Campus Finance immediately.
                    </div>
                </div>

                <div class="bubble-footer">
                    <span>Sent to {{PHONE_NUMBER}}</span>
                    <span class="delivery-check">✓✓ Delivered</span>
                </div>
            </div>
        </div>

        <div class="phone-footer">
            <div class="home-indicator"></div>
        </div>
    </div>
</body>
</html>
